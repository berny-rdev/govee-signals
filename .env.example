# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Get an API key: Govee Home app -> Profile -> Settings -> Apply for API Key.
GOVEE_API_KEY=your_govee_api_key_here

# Find these with: python3 tools/find_device.py
GOVEE_DEVICE_SKU=H6008
GOVEE_DEVICE_ID=XX:XX:XX:XX:XX:XX:XX:XX

# Optional -- only override if Govee changes their endpoint.
# GOVEE_BASE_URL=https://openapi.api.govee.com
